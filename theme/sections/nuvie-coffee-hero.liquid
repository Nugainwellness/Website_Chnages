                      {%- for value in option.values -%}
                        <option value="{{ value | escape }}" {% if option.selected_value == value %}selected{% endif %}>{{ value }}</option>
                      {%- endfor -%}
                    </select>
                  {%- else -%}
                    <div class="nch__variants">
                      {%- for value in option.values -%}
                        {%- liquid
                          assign matched_variant = product.variants | where: "title", value | first
                          assign v_pack_qty = blank
                          assign v_save = 0
                          assign v_per = blank
                          if matched_variant
                            assign v_pack_qty = matched_variant.metafields.custom.pack_qty | default: 1
                            assign v_per = matched_variant.price | divided_by: v_pack_qty
                            if matched_variant.compare_at_price > matched_variant.price
                              assign v_save = matched_variant.compare_at_price | minus: matched_variant.price | times: 100 | divided_by: matched_variant.compare_at_price
                            endif
                          endif
                        -%}
                        <div class="nch__variant-card">
                          {%- if v_save > 0 -%}
                            <div class="nch__variant-save">Save {{ v_save }}%</div>
                          {%- endif -%}
                          <input
                            type="radio"
                            class="nch__variant-radio"
                            name="Section-{{ section.id }}-options[{{ option.name }}]"
                            value="{{ value | escape }}"
                            {% if option.selected_value == value %}checked{% endif %}
                            @change="optionChange"
                            data-single-option-selector
                            data-position="{{ option.position }}"
                            {% if v_pack_qty != blank %}
                              data-pack-qty="{{ v_pack_qty }}"
                            {% else %}
                              data-pack-qty="{{ value | replace: 'Pack of', '' | strip }}"
                            {% endif %}
                          >
                          <div class="nch__variant-card__name">{{ value }}</div>
                          {%- if v_per != blank -%}
                            <div class="nch__variant-card__price">({{ v_per | money }}/{{ price_unit }})</div>
                          {%- endif -%}
                        </div>
                      {%- endfor -%}
                    </div>
                  {%- endif -%}
                </div>
              {%- endfor -%}
            {%- endunless -%}
