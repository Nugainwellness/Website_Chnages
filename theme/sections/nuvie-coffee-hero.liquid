<script>
(function(){
  var sectionId = '{{ section.id }}';
  var root = document.querySelector('[data-product-root="' + sectionId + '"]');
  if (!root) return;

  /* ────────────────────────────────────────────
     DESKTOP: Vertical thumbnail Swiper
  ──────────────────────────────────────────── */
  var thumbSwiperEl = document.getElementById('nch-thumbs-' + sectionId);
  var thumbPrevBtn  = document.getElementById('nch-thumb-prev-' + sectionId);
  var thumbNextBtn  = document.getElementById('nch-thumb-next-' + sectionId);
  var mainImages    = root.querySelectorAll('[data-nch-img]');
  var thumbSlides   = root.querySelectorAll('[data-nch-thumb]');

  var thumbSwiper = null;

  function initThumbSwiper() {
    if (window.innerWidth > 1023 && thumbSwiperEl && !thumbSwiper) {
      thumbSwiper = new Swiper(thumbSwiperEl, {
        direction: 'vertical',        /* ← KEY: vertical slide */
        slidesPerView: 'auto',        /* respect CSS height per slide */
        spaceBetween: 10,
        freeMode: false,
        watchSlidesProgress: true,
        navigation: {
          prevEl: thumbPrevBtn,
          nextEl: thumbNextBtn,
        },
        on: {
          /* keep arrow disabled states in sync */
          init: updateThumbArrows,
          slideChange: updateThumbArrows,
        }
      });

      /* click on thumb → swap main image */
      thumbSlides.forEach(function(thumb) {
        thumb.addEventListener('click', function() {
          var mediaId = thumb.getAttribute('data-media-id');

          /* update active class */
          thumbSlides.forEach(function(t) { t.classList.remove('is-active'); });
          thumb.classList.add('is-active');

          /* swap main image */
          mainImages.forEach(function(img) {
            img.style.display = (img.getAttribute('data-nch-img') === mediaId) ? '' : 'none';
          });

          /* slide thumb into view */
          var idx = parseInt(thumb.getAttribute('data-nch-thumb'), 10);
          if (thumbSwiper) thumbSwiper.slideTo(idx);
        });
      });
    } else if (window.innerWidth <= 1023 && thumbSwiper) {
      thumbSwiper.destroy(true, true);
      thumbSwiper = null;
    }
  }

  function updateThumbArrows() {
    if (!thumbSwiper) return;
    if (thumbPrevBtn) thumbPrevBtn.classList.toggle('swiper-button-disabled', thumbSwiper.isBeginning);
    if (thumbNextBtn) thumbNextBtn.classList.toggle('swiper-button-disabled', thumbSwiper.isEnd);
  }

  /* init once DOM is ready */
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initThumbSwiper);
  } else {
    initThumbSwiper();
  }
  window.addEventListener('resize', initThumbSwiper);

  /* ────────────────────────────────────────────
     MOBILE/TABLET: Horizontal product image Swiper
  ──────────────────────────────────────────── */
  var swiperEl = root.querySelector('[data-nch-swiper]');
  var mobileSwiper = null;

  function activeMediaIndex() {
    var active = root.querySelector('[data-nch-thumb].is-active');
    return active ? parseInt(active.getAttribute('data-nch-thumb'), 10) : 0;
  }

  function initMobileSwiper() {
    if (window.innerWidth <= 1023 && swiperEl && !mobileSwiper) {
      mobileSwiper = new Swiper(swiperEl, {
        slidesPerView: 1,
        spaceBetween: 12,
        initialSlide: activeMediaIndex(),
        pagination: {
          el: swiperEl.querySelector('.swiper-pagination'),
          clickable: true
        }
      });
    } else if (window.innerWidth > 1023 && mobileSwiper) {
      mobileSwiper.destroy(true, true);
      mobileSwiper = null;
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMobileSwiper);
  } else {
    initMobileSwiper();
  }
  window.addEventListener('resize', initMobileSwiper);

  /* ────────────────────────────────────────────
     Flavour change → show that variant's image
  ──────────────────────────────────────────── */
  var variantMediaEl = root.querySelector('[data-nch-variant-media]');
  var variantMedia = [];
  try { variantMedia = JSON.parse(variantMediaEl ? variantMediaEl.textContent : '[]'); } catch (err) {}
  var purchaseEl = root.querySelector('[data-nch-purchase]');
  var stickyImg = root.querySelector('[data-nch-sticky-img]');

  function showMedia(mediaId) {
    mediaId = String(mediaId);
    var idx = -1;
    thumbSlides.forEach(function(t) {
      var isMatch = t.getAttribute('data-media-id') === mediaId;
      t.classList.toggle('is-active', isMatch);
      if (isMatch) idx = parseInt(t.getAttribute('data-nch-thumb'), 10);
    });
    if (idx < 0) return;
    mainImages.forEach(function(img) {
      img.style.display = (img.getAttribute('data-nch-img') === mediaId) ? '' : 'none';
    });
    if (thumbSwiper) thumbSwiper.slideTo(idx);
    if (mobileSwiper) mobileSwiper.slideTo(idx);
  }

  function selectedOptions() {
    var selected = [];
    purchaseEl.querySelectorAll('[data-single-option-selector]').forEach(function(el) {
      var pos = parseInt(el.getAttribute('data-position'), 10) - 1;
      if (el.tagName === 'SELECT' || el.checked) selected[pos] = el.value;
    });
    return selected;
  }

  if (purchaseEl && variantMedia.length) {
    purchaseEl.addEventListener('change', function(e) {
      if (!e.target.closest('[data-single-option-selector]')) return;
      var selected = selectedOptions();
      var variant = variantMedia.find(function(v) {
        return v.options.every(function(value, i) { return selected[i] === undefined || selected[i] === value; });
      });
      if (!variant || !variant.media) return;
      showMedia(variant.media);
      if (stickyImg && variant.thumb) stickyImg.src = variant.thumb;
    });
  }

  /* ────────────────────────────────────────────
     Subscribe tab → popup
  ──────────────────────────────────────────── */
  var subTab = root.querySelector('[data-nch-tab="subscribe"]');
  var onetimeRadio = root.querySelector('[data-nch-tab="onetime"]');
  if (subTab) {
    subTab.addEventListener('click', function() {
      if (onetimeRadio) onetimeRadio.checked = true;
      if (window.Alpine && window.Alpine.store('modals')) {
        window.Alpine.store('modals').open('product-popup-subscribe');
      }
    });
  }

  /* ────────────────────────────────────────────
     Sticky add-to-cart bar
  ──────────────────────────────────────────── */
  var stickyBar = root.querySelector('[data-nch-sticky]');
  var mainButtons = root.querySelector('.nch__buttons');
  var stickyAtcBtn = root.querySelector('[data-nch-sticky-atc]');
  var mainForm = root.querySelector('form[data-product-form]');

  if (stickyBar && mainButtons) {
    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        stickyBar.classList.toggle('is-visible', !entry.isIntersecting);
      });
    }, { root: null, threshold: 0 });
    observer.observe(mainButtons);
  }

  if (stickyAtcBtn && mainForm) {
    stickyAtcBtn.addEventListener('click', function() {
      var submitBtn = mainForm.querySelector('button[type="submit"]');
      if (submitBtn && !submitBtn.disabled) submitBtn.click();
    });
  }

  /* ────────────────────────────────────────────
     Accordions
  ──────────────────────────────────────────── */
  var accTriggers = root.querySelectorAll('[data-nch-acc-trigger]');
  accTriggers.forEach(function(trigger) {
    trigger.addEventListener('click', function() {
      var accordion = trigger.closest('.nch__accordion');
      var isOpen = accordion.classList.contains('is-open');
      root.querySelectorAll('.nch__accordion').forEach(function(a) {
        a.classList.remove('is-open');
        a.querySelector('[data-nch-acc-trigger]').setAttribute('aria-expanded', 'false');
      });
      if (!isOpen) {
        accordion.classList.add('is-open');
        trigger.setAttribute('aria-expanded', 'true');
      }
    });
  });
})();

/* Cross-sell & Bundle-sell Swipers */
document.addEventListener('DOMContentLoaded', function() {
  new Swiper('.nch__cross-sell-wrap-swiper', {
    slidesPerView: 'auto',
    spaceBetween: 10,
    wrapperClass: 'nch__cross-sell-wrap',
    slideClass: 'nch__cross-card',
    navigation: { nextEl: '.is-next', prevEl: '.is-prev' },
  });
  new Swiper('.nch__bundle-sell-wrap-swiper', {
    slidesPerView: 'auto',
    spaceBetween: 10,
    wrapperClass: 'nch__cross-sell-wrap',
    slideClass: 'nch__cross-card',
    navigation: { nextEl: '.is-nexts', prevEl: '.is-prevs' },
  });
});
</script>

